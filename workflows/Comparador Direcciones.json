    {
      "parameters": {
        "jsCode": "// INPUT: items[0].json.text  (todo el texto del PDF)\n// OUTPUT: un único item con { vacantes: [...] } exactamente en el formato solicitado.\n\nfunction cleanText(t) {\n  return (t || \"\")\n    .replace(/\\u0000/g, \" \")\n    .replace(/\\r/g, \"\\n\")\n    .replace(/[ \\t]+/g, \" \")\n    .replace(/\\n[ \\t]+/g, \"\\n\")\n    .replace(/\\n{3,}/g, \"\\n\\n\")\n    .trim();\n}\n\nfunction pick(arr) {\n  return (arr || []).map(s => s.trim()).filter(Boolean);\n}\n\nfunction extractFirst(regex, str) {\n  const m = regex.exec(str);\n  return m ? (m[1] || m[0]).trim() : \"\";\n}\n\nfunction between(startLabel, endLabels, str) {\n  const start = str.indexOf(startLabel);\n  if (start < 0) return \"\";\n  const sub = str.slice(start + startLabel.length);\n  let end = sub.length;\n  for (const lab of endLabels) {\n    const i = sub.indexOf(lab);\n    if (i >= 0) end = Math.min(end, i);\n  }\n  return sub.slice(0, end).trim();\n}\n\nfunction linesToArray(block) {\n  // bullets tipo ✔, ●, •, -, * y líneas normales\n  return pick(\n    block\n      .split(\"\\n\")\n      .map(s => s.replace(/^[\\s•●\\-–—*✔]+/g, \"\").trim())\n  );\n}\n\nfunction detectTransporte(ofreceArr, fullBlock) {\n  const full = (ofreceArr.join(\" \") + \" \" + fullBlock).toLowerCase();\n  if (/(servicio de transporte|transporte de personal|apoyo de transporte|transporte incluido|cuentan con transporte)/i.test(full)) {\n    return \"Sí cuenta con transporte\";\n  }\n  if (/(no hay transporte|no tienen transporte|no cuenta con transporte)/i.test(full)) {\n    return \"No cuenta con transporte\";\n  }\n  return \"No cuenta con transporte\"; // por especificación: si no se menciona, marcar que no\n}\n\nfunction detectSueldo(ofreceArr) {\n  // Busca “Sueldo semanal”, “Pago Semanal”, “sueldo libre por semana”, etc.\n  const joined = ofreceArr.join(\" • \");\n  const rxs = [\n    /sueldo\\s*(?:semanal|por semana|semanales)?.{0,40}?(\\$\\s?[\\d\\.,]+)/i,\n    /pago\\s*semanal.{0,40}?(\\$\\s?[\\d\\.,]+)/i,\n    /sueldo\\s*libre.{0,40}?(\\$\\s?[\\d\\.,]+)/i\n  ];\n  for (const rx of rxs) {\n    const m = rx.exec(joined);\n    if (m) return m[1].replace(/\\s+/g, \"\");\n  }\n  return \"\";\n}\n\nfunction extractPuesto(block) {\n  // Tomamos lo que hay entre UBICACIÓN: ... y PERFIL:\n  const mid = between(\"UBICACIÓN:\", [\"PERFIL:\", \"Perfil:\", \"PERFIL :\", \"Perfil :\"], block);\n  if (mid) {\n    // nos quedamos con la última línea no vacía (suelen ser títulos del puesto)\n    const lines = pick(mid.split(\"\\n\"));\n    if (lines.length) {\n      return (lines[lines.length - 1] || \"\").trim();\n    }\n  }\n  // fallback: busca líneas en MAYÚSCULAS antes de PERFIL:\n  const beforePerfil = block.split(/PERFIL\\s*:/i)[0] || \"\";\n  const caps = pick(beforePerfil.split(\"\\n\"))\n    .filter(s => s.length <= 80 && /[A-ZÁÉÍÓÚÜÑ]{3}/.test(s) && !/^USUARIO:|^GIRO:|^UBICACIÓN:/i.test(s));\n  return caps.length ? caps[caps.length - 1] : \"\";\n}\n\nconst raw = items[0]?.json?.text || \"\";\nconst text = cleanText(raw);\n\n// Separamos por cada \"USUARIO:\" para obtener bloques de vacante/empresa\nlet parts = text.split(/(?:^|\\n)USUARIO:\\s*/i);\nif (parts[0].trim() === \"\") parts = parts.slice(1);\n\n// Reconstruimos añadiendo el prefijo \"USUARIO:\" a cada bloque\nconst blocks = parts.map(p => (\"USUARIO: \" + p).trim());\n\nconst vacantes = [];\n\nfor (const block of blocks) {\n  // Campos directos\n  const empresa = extractFirst(/USUARIO:\\s*([^\\n]+)/i, block);\n  const giro = extractFirst(/GIRO:\\s*([^\\n]+)/i, block);\n  const ubicacion = extractFirst(/UBICACIÓN:\\s*([^\\n]+)/i, block) || extractFirst(/UBICACION:\\s*([^\\n]+)/i, block);\n\n  // Secciones (ahora soporta también \"Horarios:\")\n  const perfilBlock = between(\"PERFIL:\", [\"OFRECE:\", \"Ofrece:\", \"HORARIO:\", \"Horario:\", \"HORARIOS:\", \"Horarios:\", \"OBSERVACIONES\", \"Observaciones\", \"USUARIO:\"], block);\n  const ofreceBlock = between(\"OFRECE:\", [\"HORARIO:\", \"Horario:\", \"HORARIOS:\", \"Horarios:\", \"OBSERVACIONES\", \"Observaciones\", \"USUARIO:\"], block);\n  const horarioText = between(\"HORARIO:\", [\"OBSERVACIONES\", \"Observaciones\", \"USUARIO:\"], block) || between(\"HORARIOS:\", [\"OBSERVACIONES\", \"Observaciones\", \"USUARIO:\"], block) || between(\"Horarios:\", [\"OBSERVACIONES\", \"Observaciones\", \"USUARIO:\"], block);\n  const obsBlock = between(\"OBSERVACIONES\", [\"USUARIO:\"], block) || between(\"Observaciones\", [\"USUARIO:\"], block);\n\n  const perfilArr = linesToArray(perfilBlock);\n  const ofreceArr = linesToArray(ofreceBlock);\n  const obsArr = linesToArray(obsBlock);\n\n  const puesto = extractPuesto(block);\n  const sueldo = detectSueldo(ofreceArr);\n  const transporte = detectTransporte(ofreceArr, block);\n\n  // Armamos objeto\n  const vac = {\n    \"puesto\": puesto || \"\",\n    \"empresa_cliente\": empresa || \"\",\n    \"giro\": giro || \"\",\n    \"ubicacion\": ubicacion || \"\",\n    \"perfil_requisitos\": perfilArr,\n    \"sueldo_semanal_libre\": sueldo,\n    \"prestaciones_beneficios\": ofreceArr,\n    \"horario\": (horarioText || \"\").replace(/\\s+/g, \" \").trim(),\n    \"ofrece_transporte\": transporte,\n    \"observaciones\": obsArr\n  };\n\n  // Filtra bloques basura y descarta los que no tengan ubicación\n  const ok =\n    (vac.empresa_cliente?.trim().length > 0) &&\n    (vac.ubicacion?.trim().length > 0) &&\n    (vac.perfil_requisitos.length > 0 || vac.prestaciones_beneficios.length > 0);\n\n  if (ok) vacantes.push(vac);\n}\n\n// Devuelve exactamente el JSON que pides\nreturn [{\n  json: { \"vacantes\": vacantes }\n}];\n\n\n\n\n"
      },
