    {
      "parameters": {
        "jsCode": "// Crea un array vacío para guardar todos los objetos.\nconst listadoCompleto = [];\n\n// La variable 'items' contiene todos los resultados\n// que llegaron desde el bucle.\n// Recorremos cada uno de esos resultados.\nfor (const item of items) {\n  // De cada resultado, tomamos su objeto 'json' y lo\n  // añadimos a nuestro listado.\n  if(item.json.EMPRESA != \"No aplica\"){\n    listadoCompleto.push(item.json);\n  }\n  \n}\n\n// Finalmente, devolvemos un único resultado.\n// Este resultado es un objeto que contiene nuestro listado completo.\nreturn listadoCompleto.map(obj => ({ json: obj }));"
      },
