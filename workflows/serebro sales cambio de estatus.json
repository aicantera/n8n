        "method": "POST",
        "url": "={{ $('flujo de actualización base de datos').item.json.base_url }}/api/v1/engage/update_user_session_by_phone_sales",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
