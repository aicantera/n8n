        "jsCode": "// Si tu binary se llama distinto a \"data\", cámbialo aquí\nconst binField = 'data';\nconst nombre_file= $input.first().json.output.title + '.pdf'\n\nfor (const item of items) {\n  if (item.binary?.[binField]) {\n    item.binary[binField].fileName = nombre_file;\n    item.binary[binField].fileExtension = 'pdf';\n    item.binary[binField].mimeType = 'application/pdf'; // opcional pero recomendable\n  }\n}\nreturn items;\n"
