      "parameters": {
        "functionCode": "return items.map((item) => {\n  try {\n    const htmlContent = item.json;\n    \n    // Función auxiliar para extraer datos de forma segura\n    const extractData = (html, className) => {\n      const regex = new RegExp(`<div class=\"${className}\">([^<]+)<\\/div>`, 'i');\n      const match = html.match(regex);\n      return match ? match[1].trim() : `Sin ${className}`;\n    };\n\n    // Extracción de datos con manejo de errores\n    const equipo = extractData(htmlContent, 'equipo');\n    const categoria = extractData(htmlContent, 'categoria');\n    const estado = extractData(htmlContent, 'estado');\n\n    // Validación adicional de datos\n    const validarTexto = (texto) => texto.length > 0 ? texto : 'No especificado';\n    \n    return {\n      json: {\n        equipo: validarTexto(equipo),\n        categoria: validarTexto(categoria),\n        estado: validarTexto(estado),\n        // Metadata útil para depuración\n        _metadata: {\n          timestamp: new Date().toISOString(),\n          source: 'SportIQS'\n        }\n      }\n    };\n    \n  } catch (error) {\n    // Manejo de errores completo\n    return {\n      json: {\n        equipo: 'Error en extracción',\n        categoria: 'Error en extracción',\n        estado: 'Error en extracción',\n        _error: {\n          message: error.message,\n          stack: error.stack\n        }\n      }\n    };\n  }\n});"
      },
