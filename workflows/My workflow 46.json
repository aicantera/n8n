    {
      "parameters": {
        "functionCode": "return items.map((item) => {\n  try {\n    // Asegurarnos que trabajamos con una cadena de texto\n    const htmlContent = typeof item.json === 'string' ? item.json : JSON.stringify(item.json);\n    \n    // Función mejorada para extracción con validación de tipo\n    const extractData = (html, className) => {\n      if (typeof html !== 'string') return `Error: HTML no es texto`;\n      \n      try {\n        const regex = new RegExp(`<div class=\"${className}\">([^<]+)<\\/div>`, 'i');\n        const match = html.match(regex);\n        return match ? match[1].trim() : `Sin ${className}`;\n      } catch (e) {\n        return `Error en ${className}: ${e.message}`;\n      }\n    };\n\n    // Extracción segura\n    const equipo = extractData(htmlContent, 'equipo');\n    const categoria = extractData(htmlContent, 'categoria');\n    const estado = extractData(htmlContent, 'estado');\n\n    return {\n      json: {\n        equipo: equipo,\n        categoria: categoria,\n        estado: estado,\n        _rawHtml: htmlContent.length > 500 ? htmlContent.substring(0, 500) + '...' : htmlContent\n      }\n    };\n    \n  } catch (error) {\n    return {\n      json: {\n        equipo: 'Error en procesamiento',\n        categoria: 'Error en procesamiento',\n        estado: 'Error en procesamiento',\n        _errorDetails: {\n          message: error.message,\n          type: error.name,\n          inputType: typeof item.json\n        }\n      }\n    };\n  }\n});"
      },
