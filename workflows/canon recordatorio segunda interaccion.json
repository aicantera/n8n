    {
      "parameters": {
        "jsCode": "const TZ            = 'America/Mexico_City';\nconst WINDOW_MS     = 24 * 60 * 60 * 1000;\nconst EXPIRATION_MS = 25 * 60 * 60 * 1000;\n\n// Obtiene el offset real de México en ms (respeta DST automáticamente)\nfunction getMxOffsetMs(date) {\n  const utcStr = date.toLocaleString('en-US', { timeZone: 'UTC' });\n  const mxStr  = date.toLocaleString('en-US', { timeZone: TZ });\n  return new Date(mxStr) - new Date(utcStr);\n}\n\n// Convierte ms a ISO con offset de México\nfunction toMxISO(ms) {\n  const date      = new Date(ms);\n  const offsetMs  = getMxOffsetMs(date);\n  const offsetH   = offsetMs / 3600000;\n  const sign      = offsetH >= 0 ? '+' : '-';\n  const hh        = Math.abs(Math.floor(offsetH)).toString().padStart(2, '0');\n  const mm        = Math.abs((offsetMs % 3600000) / 60000).toString().padStart(2, '0');\n  const localMs   = ms + offsetMs;\n  return new Date(localMs).toISOString().slice(0, 23) + `${sign}${hh}:${mm}`;\n}\n\n// --- Lógica principal ---\nconst now        = new Date();\nconst offsetMs   = getMxOffsetMs(now);\nconst nowMs      = now.getTime() + offsetMs;\n\nconst reminderRaw = Date.parse($json.remember_at);\n\nif (Number.isNaN(reminderRaw)) {\n  return [{ json: { ...$json, within_window: false, reason: 'invalid_reminder_at' } }];\n}\n\nconst reminderMs   = reminderRaw + offsetMs;\nconst windowEndsMs = reminderMs + WINDOW_MS;\nconst expiresMs    = reminderMs + EXPIRATION_MS;\n\nconst within = nowMs >= reminderMs && nowMs <= windowEndsMs;\n\nreturn [{\n  json: {\n    ...$json,\n    within_window:   within,\n    now_iso:         toMxISO(now.getTime()),\n    reminder_iso:    toMxISO(reminderRaw),\n    window_ends_iso: toMxISO(reminderRaw + WINDOW_MS),\n    expires_iso:     toMxISO(reminderRaw + EXPIRATION_MS),\n  }\n}];"
      },
