    {
      "parameters": {
        "jsCode": "// Supongamos que el nodo anterior se llama \"Set1\" y en el campo json almacena tu arreglo\n// Lo obtenemos desde items del flujo\nconst inputData = $json[\"Data\"]; // si es un único objeto\n// O si el Set anterior tiene la data en un campo específico\n// const inputData = $json[\"miCampo\"]; \n\n// Si tu Set anterior contiene la lista completa como JSON en un solo campo\n// asegúrate de parsearla:\nlet dataArray;\ntry {\n\tdataArray = JSON.parse(inputData); // cambia \"miLista\" por el nombre real del campo\n} catch (e) {\n\t// Si ya viene como array, no hace falta parsear\n\tdataArray = inputData;\n}\n\n// Función para validar si todos los valores son \"No aplica\"\nfunction esNoAplica(obj) {\n\treturn Object.values(obj).every(v => v.trim().toLowerCase() === \"no aplica\");\n}\n\n// Procesar datos\nconst resultado = dataArray\n\t.map(item => {\n\t\t// Cada item.Data es un string JSON → lo parseamos\n\t\tconst obj = JSON.parse(item.Data);\n\t\treturn obj;\n\t})\n\t.filter(obj => !esNoAplica(obj)); // quitamos los \"No aplica\"\n\n// Retornamos como array iterativo para n8n\nreturn resultado.map(r => ({ json: r }));\n"
      },
      "type": "n8n-nodes-base.code",
