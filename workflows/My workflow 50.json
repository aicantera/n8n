      "name": "Convert to File"
    },
    {
      "parameters": {
        "jsCode": "// Obtiene el contenido del texto del nodo anterior.\nconst inputText = $input.first().json.data;\n\nif (typeof inputText !== 'string') {\n    throw new Error('La entrada del nodo no es un string.');\n}\n\n// Reemplaza los saltos de línea y múltiples espacios por uno solo para simplificar el parsing.\nconst cleanedText = inputText.replace(/\\r\\n\\s*(\\r\\n)+/g, '\\n\\n').replace(/ /g, ' ').trim();\n\n// Divide el texto en bloques de perfiles usando el separador \"USUARIO: \"\nconst profiles = cleanedText.split('USUARIO: ');\n\n// El primer elemento es el encabezado del documento, lo filtramos.\nconst structuredProfiles = profiles.filter(profileText => profileText.trim() !== '').map(profileText => {\n    \n    // Extrae el usuario y el puesto principal usando el primer y segundo salto de línea.\n    const userAndTitleMatch = profileText.match(/^(.*?)\\n(GIRO:.*?)[\\n\\r]*\\s*(.*?)\\n\\nPERFIL:/);\n    \n    let usuario = null;\n    let giro = null;\n    let ubicacion = null;\n    let puesto = null;\n\n    if (userAndTitleMatch && userAndTitleMatch[1]) {\n        usuario = userAndTitleMatch[1].trim();\n        const giroUbiMatch = userAndTitleMatch[2].match(/GIRO: (.*?)\\s*UBICACIÓN: (.*)/);\n        if (giroUbiMatch) {\n            giro = giroUbiMatch[1].trim();\n            ubicacion = giroUbiMatch[2].trim();\n        } else {\n            const giroMatch = userAndTitleMatch[2].match(/GIRO: (.*)/);\n            if (giroMatch) {\n              giro = giroMatch[1].trim();\n            }\n            const ubicacionMatch = profileText.match(/UBICACIÓN: (.*?)\\s*GIRO:/);\n            if (ubicacionMatch) {\n              ubicacion = ubicacionMatch[1].trim();\n            }\n        }\n        puesto = userAndTitleMatch[3].trim().replace(/\\r\\n/g, ' ');\n    } else {\n      // Manejo de casos alternativos si el patrón principal no coincide\n      const generalMatch = profileText.match(/(.*?)\\nGIRO:\\s*(.*?)\\s*UBICACIÓN:\\s*(.*?)\\s*(.*?)\\n\\nPERFIL:/);\n      if (generalMatch) {\n        usuario = generalMatch[1].trim();\n        giro = generalMatch[2].trim();\n        ubicacion = generalMatch[3].trim();\n        puesto = generalMatch[4].trim();\n      }\n    }\n    \n    // Secciones principales: PERFIL, OFRECE, HORARIO, OBSERVACIONES\n    const perfilMatch = profileText.match(/PERFIL:\\n([\\s\\S]*?)\\n\\nOFRECE:/);\n    const ofreceMatch = profileText.match(/OFRECE:\\n([\\s\\S]*?)\\n\\nHORARIO:/);\n    const horarioMatch = profileText.match(/HORARIO:([\\s\\S]*?)(?=\\n\\nOBSERVACIONES|\\n\\n_|$)_?$/);\n    const observacionesMatch = profileText.match(/(OBSERVACIONES.*?:)\\n([\\s\\S]*)/);\n    \n    // Creación del objeto de perfil\n    const profile = {\n        usuario: usuario,\n        giro: giro,\n        ubicacion: ubicacion,\n        puesto: puesto,\n        perfil: perfilMatch ? perfilMatch[1].trim() : null,\n        ofrece: ofreceMatch ? ofreceMatch[1].trim() : null,\n        horario: horarioMatch ? horarioMatch[1].trim() : null,\n        observaciones: observacionesMatch ? observacionesMatch[2].trim() : null\n    };\n\n    return profile;\n});\n\n// Devuelve un array de objetos, uno para cada perfil extraído.\n// Esto cumple con el formato de salida esperado por n8n.\nreturn structuredProfiles.map(profile => ({ json: profile }));"
      },
