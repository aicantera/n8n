      "name": "Cada Hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -1056,
        176
      ],
      "id": "05282f8e-fb03-4c7c-8cac-cf89a327f409"
    },
    {
      "parameters": {
        "jsCode": "// Procesar y clasificar registros\nconst now = new Date();\nconst results = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n  \n  try {\n    // Convertir fecha dd-mm-yyyy\n    const [day, month, year] = data.dia.split('-').map(Number);\n    const [hours, minutes] = data.hora.split(':').map(Number);\n    \n    // Crear fecha del evento\n    const eventDate = new Date(year, month - 1, day, hours, minutes);\n    \n    // Calcular diferencia\n    const diffMs = eventDate - now;\n    const diffHours = diffMs / (1000 * 60 * 60);\n    \n    // Clasificar\n    let category = 'skip';\n    \n    if (diffMs < 0) {\n      category = 'delete';\n    } else if (diffHours <= 1 && diffHours > 0) {\n      category = '1hour';\n    } else if (diffHours <= 12 && diffHours > 1) {\n      category = '12hours';\n    } else if (diffHours <= 24 && diffHours > 12) {\n      category = '24hours';\n    }\n    \n    results.push({\n      json: {\n        ...data,\n        category,\n        diffHours: Math.round(diffHours * 100) / 100\n      }\n    });\n  } catch (error) {\n    console.error('Error procesando registro:', data, error);\n  }\n}\n\nreturn results;"
      },
      "name": "Clasificar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
