    {
      "parameters": {
        "functionCode": "const report = [];\n\nfunction parseIsoToMs(iso) {\n  if (!iso || typeof iso !== 'string') return NaN;\n  let s = iso.trim();\n  if (/\\.\\d{4,}/.test(s)) s = s.replace(/\\.(\\d{3})\\d+/, '.$1');\n  s = s.replace(' ', 'T');\n\n  let t = Date.parse(s);\n  if (!Number.isNaN(t)) return t;\n\n  t = Date.parse(s.replace(/\\+00:00$/, 'Z'));\n  if (!Number.isNaN(t)) return t;\n\n  t = Date.parse(s.replace(/\\.\\d+/, ''));\n  return t;\n}\n\nconst nowUtcMs = Date.now();\n\nfor (const { json: data = {} } of items) {\n  const convType = (data.type_conversation ?? '').toString().trim().toLowerCase();\n  const state = (data.states.parent_state ?? '').toString().trim();\n  const iso = data.last_updated;\n  const ms = parseIsoToMs(iso);\n  const okParse = Number.isFinite(ms);\n  const diffMin = okParse ? (nowUtcMs - ms) / 60000 : null;\n\n  let reason = 'eligible';\n  if (convType !== 'chatbot') reason = 'not_chatbot';\n  else if (!okParse) reason = 'invalid_date';\n  else if (!(diffMin > 20)) reason = 'not_inactive';\n  else if (state === 'menuInicial') reason = 'already_menuInicial';\n  const states = {\n    parent_state:\"menuInicial\"\n  }\n  const phoneNumber = data.phone_whatsapp;\n\n  report.push({\n    _id: data._id,\n    last_updated: new Date(iso),\n    parsed_ok: okParse,\n    diffMin,\n    type_conversation: data.type_conversation,\n    state,\n    states,\n    reason,\n    phoneNumber\n  });\n}\n\nreturn report.map(r => ({ json: r }));\n"
      },
