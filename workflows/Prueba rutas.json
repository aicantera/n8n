    {
      "parameters": {
        "jsCode": "const instructions = [];\nconst steps = $json[\"routes\"][0][\"legs\"][0][\"steps\"];\n\nfor (let i = 0; i < steps.length; i++) {\n  if(steps[i][\"navigationInstruction\"] && steps[i][\"navigationInstruction\"][\"instructions\"]){\n    instructions.push(steps[i][\"navigationInstruction\"][\"instructions\"]);\n  }else{\n    instructions.push(\"No instructions available foo thi step\");\n  }\n}\n\nreturn [{ json: { all_instructions: instructions } }];"
