    {
      "parameters": {
        "jsCode": "// Obtiene el primer item que llega al nodo.\nconst item = items[0];\n\n// Extrae el string de la propiedad \"output\".\nconst jsonString = item.json.output;\n\n// Convierte (parsea) el string a un objeto/array de JavaScript.\nconst cleanData = JSON.parse(jsonString);\n\n// n8n necesita que retornes un array de objetos, donde cada objeto\n// tiene una propiedad \"json\" que contiene tus datos.\n// Usamos .map() para transformar cada elemento del array al formato correcto.\nreturn cleanData.map(data => ({ json: data }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
