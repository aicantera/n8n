    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const data = item.json;\n\n  // 1. Ponemos las 3 aprobaciones en una lista para facilitar el conteo\n  // Asegúrate que los nombres de los campos coincidan exactamente con tu salida anterior\n  const aprobaciones = [\n    data.aprobacion_rh,\n    data.aprobacion_lider,\n    data.aprobacion_pm\n  ];\n\n  // 2. Contamos cuántos True y cuántos False hay\n  // Nota: Filtramos estrictamente por valor booleano\n  const votosPositivos = aprobaciones.filter(v => v === true).length;\n  const votosNegativos = aprobaciones.filter(v => v === false).length;\n\n  // 3. Lógica de Mayoría (2 de 3)\n  let resolucion = 'pendiente'; // Estado por defecto (si hay nulls o empate 1-1)\n\n  if (votosPositivos >= 2) {\n    resolucion = 'aprobada';\n  } else if (votosNegativos >= 2) {\n    resolucion = 'rechazada';\n  }\n\n  // 4. Agregamos el nuevo campo al objeto JSON\n  item.json.resolucion_final = resolucion;\n  \n  // Opcional: Agregar detalles del conteo por si quieres depurar\n  item.json.conteo_votos = { afavor: votosPositivos, encontra: votosNegativos };\n\n  return item;\n});"
      },
