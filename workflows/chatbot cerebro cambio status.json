    {
      "parameters": {
        "jsCode": "// Lee el objeto de entrada\nconst input = items[0]?.json ?? {};\n\n// Lista blanca de campos esperados (evita que se cuelen otros)\nconst allowedKeys = [\n  'state',\n  'child_state',\n  'userId',\n  'phoneNumber',\n  'info',\n  'grade_state',\n  'ticket_type',\n  'type_conversation',\n  'student_id',\n  'course_selected',\n  'justify_state',\n  'justify_selected_date',\n];\n\n// Función para detectar “vacío”\nconst isEmpty = (v) => (\n  v === null ||\n  v === undefined ||\n  (typeof v === 'string' && v.trim() === '') ||\n  (Array.isArray(v) && v.length === 0) ||\n  (typeof v === 'object' && !Array.isArray(v) && Object.keys(v).length === 0) ||\n  v === 'null' ||              // por si llega literal como string\n  v === 'undefined'            // idem\n);\n\n// Filtra solo claves permitidas y no vacías\nconst cleaned = Object.fromEntries(\n  Object.entries(input)\n    .filter(([k]) => allowedKeys.includes(k))\n    .filter(([_, v]) => !isEmpty(v))\n);\n\n// Agrega la fecha actual en formato requerido\ncleaned.now = new Date().toLocaleString('es-MX', {\n  timeZone: 'America/Mexico_City'\n});\n\n// Devuelve un único item con el objeto “limpio” + fecha\nreturn [{ json: cleaned }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        112
      ],
      "id": "c8a1b806-c3fb-4e7f-b26e-68233ed8d757",
      "name": "Code"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('flujo de actualización base de datos').item.json.base_url }}/api/v1/engage/update_user_session_by_phone",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        512,
        112
      ],
      "id": "74440457-7644-4c98-8ff9-c978e0dfff1f",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "// Tomamos el objeto limpio del nodo anterior\nconst input = items[0]?.json ?? {};\nconst states = {\n  parent_state:input.state,\n  child_state:input.child_state\n}\n\n// Construimos el body de la petición\nconst body = {\n  phone: input.phoneNumber,        // obligatorio\n  states: states,\n  userId: input.userId,\n  information: input.info,         // mapeado a \"information\"\n  grade_state: input.grade_state,\n  type_conversation: input.type_conversation,\n  student_id: input.student_id,\n  course_selected: input.course_selected,\n  justify_state: input.justify_state,\n  ticket_type:input.ticket_type,\n  justify_selected_date: input.justify_selected_date,\n  date: input.now                   // si quieres mandar la fecha actual también\n};\n\n// Retornamos un único item con el body\nreturn [{ json: body }];\n"
      },
