    {
      "parameters": {
        "jsCode": "// Run Once for All Items\n \n// Detecta si el objeto es del tipo \"ruta\"\nfunction esRuta(obj) {\n  // Tiene row_number o las claves características de ruta\n  const tieneClavesRuta =\n    Object.prototype.hasOwnProperty.call(obj, 'Ruta') &&\n    Object.prototype.hasOwnProperty.call(obj, 'latitud') &&\n    Object.prototype.hasOwnProperty.call(obj, 'longitud');\n \n  return (\n    Object.prototype.hasOwnProperty.call(obj, 'row_number') ||\n    tieneClavesRuta\n  );\n}\n \n// Detecta si el objeto es \"No aplica\"\nfunction esNoAplica(obj) {\n  const valor = (v) => (typeof v === 'string' ? v.trim().toLowerCase() : v);\n  // Regla principal: EMPRESA = \"No aplica\"\n  if (valor(obj.EMPRESA) === 'no aplica') return true;\n \n  // Opcional: si todos los campos principales son \"No aplica\"\n  const campos = [\n    'EMPRESA','PUESTO','UBICACIÓN','GIRO','PERFIL',\n    'SUELDO SEMANAL LIBRE','BENEFICIOS','HORARIO',\n    'TRANSPORTE','OBSERVACIONES'\n  ];\n  const hayCampos = campos.some(k => k in obj);\n  if (hayCampos) {\n    const todosNoAplica = campos\n      .filter(k => k in obj)\n      .every(k => valor(obj[k]) === 'no aplica');\n    if (todosNoAplica) return true;\n  }\n  return false;\n}\n \n// Construye el listado limpio a partir de los items que llegan del bucle\nconst listadoLimpio = [];\nfor (const item of items) {\n  const obj = item.json || {};\n  if (esRuta(obj)) continue;         // descarta rutas\n  if (esNoAplica(obj)) continue;     // descarta \"No aplica\"\n  listadoLimpio.push(obj);           // conserva el resto\n}\n \n// Devuelve en el formato que n8n espera\nreturn listadoLimpio.map(o => ({ json: o }));"
      },
