    {
      "parameters": {
        "jsCode": "const allFiles = $json; // El output del nodo Listar es un array directo, no dentro de 'data' o 'items[0].json.data'\nconst targetFileName = \"$Rentabilidad_BarterFlip.txt\"; // <<< ¡IMPORTANTE! Reemplaza esto con el NOMBRE EXACTO de tu archivo de Google Doc/Texto Plano\nlet foundFile = null;\n\nif (Array.isArray(allFiles)) {\n    for (const file of allFiles) {\n        // El nombre del archivo se encuentra al final de la 'webUrl'\n        // Extraemos el nombre completo del archivo (ej. \"Rentabilidad_BarterFlip.csv\")\n        const fileNameFromUrl = file.webUrl ? file.webUrl.substring(file.webUrl.lastIndexOf('/') + 1) : null;\n\n        // Comparamos con el nombre que buscamos\n        if (fileNameFromUrl === targetFileName) {\n            foundFile = file;\n            break; // Encontramos el archivo, salimos del bucle\n        }\n    }\n}\n\nif (foundFile) {\n    return [{\n        json: {\n            fileId: foundFile.id,       // Extraemos el ID\n            fileName: targetFileName,   // Guardamos el nombre para referencia\n            webUrl: foundFile.webUrl    // Opcional: la URL del archivo\n        }\n    }];\n} else {\n    // Lanza un error si el archivo no se encuentra.\n    // n8n detendrá la ejecución aquí, puedes usar un nodo de manejo de errores si lo prefieres.\n    throw new Error(`El archivo '${targetFileName}' no fue encontrado en la lista de OneDrive/SharePoint.`);\n}"
      },
