    {
      "parameters": {
        "jsCode": "// Mapeo de meses en español a número\nconst meses = {\n  'enero': 0, 'febrero': 1, 'marzo': 2, 'abril': 3,\n  'mayo': 4, 'junio': 5, 'julio': 6, 'agosto': 7,\n  'septiembre': 8, 'octubre': 9, 'noviembre': 10, 'diciembre': 11\n};\n\n// Obtenemos el mes y año actual\nconst ahora = new Date();\nconst mesActual = ahora.getMonth() - 1;\nconst anioActual = ahora.getFullYear();\n\n// Array para guardar los resultados filtrados\nconst resultadosFiltrados = [];\n\n// Iteramos sobre cada item (fila) que llega al nodo\nfor (const item of $input.all()) {\n  // Extraemos la fecha del JSON\n  const fechaString = item.json.Fecha;\n\n  // \"18 de agosto de 2025 13:28\" -> [\"18\", \"agosto\", \"2025\", \"13:28\"]\n  const partes = fechaString.replace(' de ', ' ').replace(' de ', ' ').split(' ');\n  const dia = parseInt(partes[0]);\n  const mes = meses[partes[1].toLowerCase()];\n  const anio = parseInt(partes[2]);\n\n  // Si el mes y el año de la fila coinciden con el actual, lo guardamos\n  if (mes === mesActual && anio === anioActual) {\n    resultadosFiltrados.push(item);\n  }\n}\n\n// Devolvemos solo los items que cumplen la condición\nreturn resultadosFiltrados;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        1120
      ],
      "id": "6b5fac89-c139-4af7-832f-877303f7b0dd",
      "name": "Code"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0) {\n  return [{ json: { html: \"<p>No hay interacciones para reportar este mes.</p>\" } }];\n}\n\nlet tablaHtml = `\n  <h1>Reporte de Interacciones del Mes</h1>\n  <p>Total de interacciones: ${items.length}</p>\n  <table border=\"1\" style=\"width:100%; border-collapse: collapse;\">\n    <thead>\n      <tr>\n        <th style=\"padding: 8px; background-color: #f2f2f2;\">Fecha</th>\n        <th style=\"padding: 8px; background-color: #f2f2f2;\">Hora</th> <th style=\"padding: 8px; background-color: #f2f2f2;\">Nombre</th>\n        <th style=\"padding: 8px; background-color: #f2f2f2;\">Solicitud</th>\n      </tr>\n    </thead>\n    <tbody>\n`;\n\nfor (const item of items) {\n  // Asegúrate que los nombres de las propiedades (item.json.Fecha, item.json.Hora, etc.)\n  // coincidan EXACTAMENTE con los encabezados de tu Google Sheet.\n  tablaHtml += `\n    <tr>\n      <td style=\"padding: 8px;\">${item.json.Fecha}</td>\n      <td style=\"padding: 8px;\">${item.json.Hora || ''}</td> <td style=\"padding: 8px;\">${item.json.Nombre}</td>\n      <td style=\"padding: 8px;\">${item.json.Solicitud}</td>\n    </tr>\n  `;\n}\n\ntablaHtml += `\n    </tbody>\n  </table>\n`;\n\nreturn [{ json: { html: tablaHtml } }];"
      },
