    {
      "id": "1208ce4e-2342-4700-8d15-0649b1d27c05",
      "name": "Parsear Lead Caliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst chat_id = raw.chat_id || 'pendiente';\nconst nombre = raw.nombre || 'No proporcionado';\nconst producto = raw.producto || 'terrenos';\nconst perfil = raw.perfil || 'sin_clasificar';\nconst resumen = raw.resumen || 'Sin resumen';\n\nconst lineas = [\n  '🔥 *LEAD CALIENTE - TERRENOS TZINTZUNI*',\n  '',\n  '🌲 *Desarrollo:* Tzintzuni Arboledas, Patzcuaro',\n  '👤 *Nombre:* ' + nombre,\n  '⭐ *Perfil:* ' + perfil,\n  '📋 *Resumen:* ' + resumen,\n  '',\n  '📱 *Referencia chat:* ' + chat_id\n];\n\nreturn [{ json: { chat_id, nombre, producto, perfil, resumen, mensaje_asesor: lineas.join('\\n') } }];"
      }
    },
    {
      "id": "24f3d2b3-7475-483b-9e48-9f21f1f228ea",
      "name": "Avisar al Asesor Terrenos",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "PENDING_ASESOR_TERRENOS",
        "text": "={{ $json.mensaje_asesor }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "Markdown"
        }
